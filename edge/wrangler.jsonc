{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rustruct",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-11",
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "25fca3591fd04da6a2a7446d7b40a05e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "rustruct-storage"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rustruct",
      "database_id": "de40cb28-d0a9-4092-920c-1abec8519b34"
    }
  ]
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
